# .repos — 依赖清单（vcstool）
#
# 本文件 pin commit，不使用分支。变更必须说明理由
# （见 foray_docs/repository_structure.md §6.3）。
#
# 导入：在本仓根执行 scripts/import_repos.sh（内部调用 vcs import）。

repositories:
  # 厂商 SDK：放在 src/ 之外，避免 colcon 识别为包。
  # 由 scripts/build_livox_sdk2.sh 构建并安装到私有前缀。
  third_party/livox_sdk2:
    type: git
    url: https://github.com/Livox-SDK/Livox-SDK2.git
    version: f5d9375f84efe2b15bc0a052d3e18482ed13adf4  # v1.3.1

  # 海康 MVS 相机 SDK：闭源，组织**私有**仓（private），只承载分发，不参与 colcon。
  # 拉取需要 GitHub 凭据（token 或部署密钥）。
  # 只含头文件与 amd64 主库；传输层插件不在仓内，见 scripts/install_mvs_sdk.sh --package。
  third_party/mvs_sdk:
    type: git
    url: https://github.com/ZQU-Foray/mvs-sdk.git
    version: b55df46b6dbbf20a21afe6885c2125620aa6209a  # SDK V4.8.0.3 + 插件/打包脚本

  # 上游 ROS 包（colcon 构建）：pin 到本仓 src/ 实测可跑通仿真链的 commit，
  # 不是「上游最新」。依据见 decision.md（2026-11-12）与 foray_docs §8 M2/M3。
  # 目录名与沙箱 src/ 完全一致，vcs import 后可零改动重建。
  src/pb2025_sentry_nav:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/pb2025_sentry_nav.git
    version: 5f645d60e8cb88440f0bb44fc63209f136a95a49  # fork 基线，含 point_lio

  src/pb2025_robot_description:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/pb2025_robot_description.git
    version: a0541dddcbfe376f369a6345b532a10923ad9149  # pb2025 步兵/哨兵 xmacro

  src/rmoss_core:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_core.git
    version: 8209ec517dfbb7ecac613cf0c9534d67ff918b7d

  src/rmoss_gazebo:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_gazebo.git
    version: 7443ff06c345752d0e23172c479d99b27207e2c7

  src/rmoss_gz_resources:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_gz_resources.git
    version: b5c759f08844dfda19c79aa870866ace8d4c7b3a

  src/rmoss_interfaces:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_interfaces.git
    version: 424f50c831b3e74fa72446969362cdabb2e22cd1

  src/sdformat_tools:
    type: git
    url: https://github.com/gezp/sdformat_tools.git
    version: 47c2d1a37372281e5627d444f7537efc0bba11df

  # rmoss_cam 依赖 camera_info_manager；它不在 ROS 2 base 安装里，
  # 宿主没有 sudo 装不了 ros-humble-camera-info-manager，因此按源码 pin 入账。
  src/image_common:
    type: git
    url: https://github.com/ros-perception/image_common.git
    version: 28775054b0f85565f2a0213d2ab8a965e848dc5b

  # 非 colcon 依赖：small_gicp 是纯头文件 C++ 库，由 pb2025_sentry_nav 取用。
  # 本地沙箱放在 deps/small_gicp，本仓规范放 third_party/，同一 commit。
  third_party/small_gicp:
    type: git
    url: https://github.com/koide3/small_gicp.git
    version: fa0cfc983417c044b6036f71dfa448038bb9c820

  # 自研仓：pin 到 dev 上已过 CI 的 commit。改这里必须同时改 VERSIONS.md，
  # 由 scripts/check_repos_drift.sh 校验工作区是否与清单一致。
  # 顺序按依赖自下而上：interfaces（X2）→ platform（L1/L2）→ vision_frontend（L3）
  # → vision_backend（L4）。
  src/diesel_interfaces:
    type: git
    url: https://github.com/ZQU-Foray/diesel_interfaces.git
    version: 752f8a4  # 视觉前后端契约 v0.1.0 草案（PR #5）

  src/diesel_platform:
    type: git
    url: https://github.com/ZQU-Foray/diesel_platform.git
    version: 58e617f  # diesel 命名收敛（PR #7）；提供 diesel_platform_core

  # 视觉前后端分家后的两个仓：前端 = 检测 + PnP，后端 = 融合 + 跟踪 + 瞄准。
  src/diesel_vision_frontend:
    type: git
    url: https://github.com/ZQU-Foray/diesel_vision_frontend.git
    version: ac11181  # 多目标检测抽象（Detector/registry）

  src/diesel_vision_backend:
    type: git
    url: https://github.com/ZQU-Foray/diesel_vision_backend.git
    version: b97bed6  # 多源融合与 WorldSnapshot（PR #10）
